<template name="receiptEditor">
 <view class="card"><view class="edit-columns"><text class="grow name">实际收衣</text><text>数量</text><text>单价 / 元</text><text class="remove-column"/></view>
 <view wx:for="{{editItems}}" wx:key="id" class="intake-row"><text class="grow">{{item.name}}</text><input type="number" value="{{item.qty}}" data-index="{{index}}" data-key="qty" bindinput="editField" aria-label="{{item.name}}数量"/><input type="digit" value="{{item.priceText}}" data-index="{{index}}" data-key="priceText" bindinput="editField" aria-label="{{item.name}}单价"/><button class="remove-item" data-index="{{index}}" bindtap="removeIntakeItem" aria-label="移除{{item.name}}">移除</button></view>
 <picker mode="selector" range="{{enabledProducts}}" range-key="name" bindchange="addIntakeItem"><view class="add-intake">添加衣物项目</view></picker>
 <label wx:if="{{editChanged || editingReceipt}}" class="field">调整原因<input value="{{reason}}" bindinput="reason" maxlength="200" placeholder="例如：实际少送一件、特殊处理"/></label>
 <button wx:if="{{!editingReceipt}}" class="back intake-toggle" bindtap="toggleIntake">挂号、位置与预计日期（选填） {{showIntake?'收起':'展开'}}</button>
 <view wx:if="{{showIntake && !editingReceipt}}"><label class="field">挂号／纸票号<input data-key="ticketNo" value="{{intakeForm.ticketNo}}" bindinput="intakeField" maxlength="30"/></label><label class="field">存放位置<input data-key="storageLocation" value="{{intakeForm.storageLocation}}" bindinput="intakeField" maxlength="60" placeholder="例如：A架12号"/></label><view class="field">预计完成日期<picker mode="date" value="{{intakeForm.dueDate}}" bindchange="dueDate"><view>{{intakeForm.dueDate || '选择日期'}}</view></picker><button wx:if="{{intakeForm.dueDate}}" class="text-action" bindtap="clearDueDate">清除日期</button></view></view>
 <view class="line"/><view class="row"><text>本次确认金额</text><text class="price">¥{{intakeTotal}}</text></view><checkbox-group bindchange="agreed"><label class="agreement"><checkbox value="yes" checked="{{agreed}}"/>已核对实际衣物，并与顾客确认金额</label></checkbox-group>
 <button wx:if="{{guestReview}}" class="primary form-save" bindtap="submit" disabled="{{busy || !editItems.length}}" loading="{{busy}}">确认收衣并开单</button><button wx:else class="primary form-save" bindtap="accept" disabled="{{busy || !editItems.length}}" loading="{{busy}}">{{editingReceipt?'保存调整后的衣物与金额':'确认收衣'}}</button>
 </view>
</template>
<view wx:if="{{loading}}" class="empty">正在连接门店…</view>
<view wx:elif="{{notice}}" class="wrap"><view class="notice">{{notice}}</view><button class="primary" bindtap="retryConnection">重新连接门店</button><button wx:if="{{store.phone}}" class="secondary form-save" data-phone="{{store.phone}}" bindtap="callPhone">联系门店</button><button class="secondary" bindtap="copyId" wx:if="{{openid}}">复制微信身份标识</button></view>
<block wx:else>
<view class="wrap {{adminMode?'owner-wrap':''}}">
<block wx:if="{{page==='workbench' && adminMode}}">
 <button class="primary quick-open" data-page="guest" bindtap="go" disabled="{{busy}}"><image src="/assets/action-add.png" class="quick-open-icon"/>到店开单</button>
 <view class="task-grid">
  <button class="task-button" data-filter="待送店" bindtap="taskOrders" disabled="{{busy}}" aria-label="待收衣 {{stats.pending===null?'数量未加载':stats.pending+'单'}}"><view class="task-top"><image class="task-icon" src="/assets/action-receive.png"/><text class="task-count {{stats.pending>0?'has-tasks':''}}">{{stats.pending===null?'—':stats.pending}}</text></view><text>待收衣</text></button>
  <button class="task-button" data-filter="洗护中" bindtap="taskOrders" disabled="{{busy}}" aria-label="洗护中 {{stats.processing===null?'数量未加载':stats.processing+'单'}}"><view class="task-top"><image class="task-icon" src="/assets/nav-wash-active.png"/><text class="task-count {{stats.processing>0?'has-tasks':''}}">{{stats.processing===null?'—':stats.processing}}</text></view><text>洗护中</text></button>
  <button class="task-button" data-filter="待通知" bindtap="taskOrders" disabled="{{busy}}" aria-label="待通知 {{stats.unnotified===null?'数量未加载':stats.unnotified+'单'}}"><view class="task-top"><image class="task-icon" src="/assets/action-phone.png"/><text class="task-count {{stats.unnotified>0?'has-tasks':''}}">{{stats.unnotified===null?'—':stats.unnotified}}</text></view><text>待通知</text></button>
  <button class="task-button" data-filter="待取件" bindtap="taskOrders" disabled="{{busy}}" aria-label="待取件 {{stats.ready===null?'数量未加载':stats.ready+'单'}}"><view class="task-top"><image class="task-icon" src="/assets/action-pickup.png"/><text class="task-count {{stats.ready>0?'has-tasks':''}}">{{stats.ready===null?'—':stats.ready}}</text></view><text>待取件</text></button>
 </view>
 <view class="task-refresh"><text class="muted">{{statsError?(statsUpdatedAt?'更新失败，显示上次结果':'待办数量加载失败'):statsLoading?'正在更新待办':statsUpdatedAt?'更新于 '+statsUpdatedAt:'待办数量尚未加载'}}</text><button class="text-action" bindtap="loadWorkbench" disabled="{{statsLoading}}">{{statsError?'重试':'刷新'}}</button></view>
 <view class="extra-tasks"><button class="secondary" data-filter="超期" bindtap="taskOrders">超期 {{extraStats.overdue===null?'—':extraStats.overdue}}</button><button class="secondary" data-filter="异常" bindtap="taskOrders">异常 {{extraStats.exceptions===null?'—':extraStats.exceptions}}</button></view><view class="owner-menu workbench-tools"><button class="owner-menu-item" data-page="prices" bindtap="go" disabled="{{busy}}"><image class="menu-icon" src="/assets/nav-orders-active.png"/><text class="grow name">价目管理</text><text class="menu-arrow">›</text></button></view>
</block>
<block wx:if="{{page==='manage' && adminMode}}">
 <button class="profile-header" data-page="settings" bindtap="go" disabled="{{busy}}"><image class="profile-avatar" src="/assets/store-badge.png" mode="aspectFill"/><view class="grow"><view class="profile-name">{{store.name}}</view><view class="profile-role">店主 · {{store.open?'接单中':'暂停接单'}}</view></view><text class="menu-arrow">›</text></button>
 <view class="profile-group"><button class="owner-menu-item" data-page="settings" bindtap="go" disabled="{{busy}}"><image class="menu-icon" src="/assets/nav-store-active.png"/><text class="grow">门店资料与营业设置</text><text class="menu-arrow">›</text></button></view>
 <view class="profile-group"><button class="owner-menu-item" bindtap="subscribeOrders"><image class="menu-icon" src="/assets/action-bell.png"/><text class="grow">新订单提醒</text><text class="menu-arrow">›</text></button><button class="owner-menu-item" data-page="help" bindtap="go" disabled="{{busy}}"><image class="menu-icon" src="/assets/action-help.png"/><text class="grow">使用帮助</text><text class="menu-arrow">›</text></button></view>
 <view class="profile-group"><button class="owner-menu-item" bindtap="exportBackup" disabled="{{busy}}"><text class="grow">导出订单与价目数据</text><text class="menu-arrow">›</text></button><button class="owner-menu-item" bindtap="openRetention" disabled="{{busy}}"><text class="grow">到期订单核查</text><text class="menu-arrow">›</text></button></view>
 <view class="profile-group"><button class="owner-menu-item" bindtap="mode" disabled="{{busy}}"><image class="menu-icon" src="/assets/action-switch.png"/><text class="grow">切换顾客端</text><text class="menu-arrow">›</text></button></view>
</block>
<block wx:if="{{page==='help' && adminMode}}"><button class="back" data-page="manage" bindtap="go">← 返回我的门店</button><view class="heading">使用帮助</view><view class="card help-content"><view class="name">收衣与取件</view><view class="muted">顾客到店可直接开单。线上订单在“待收衣”核对衣物与价格，洗好后标记待取件，再电话通知顾客并登记取件。</view><view class="name">待办数量</view><view class="muted">数量按订单计算。待通知包含未通知和未接通的待取件订单，因此也计入待取件数量。可在工作台点击刷新。</view><view class="name">新订单提醒</view><view class="muted">微信每次订阅通常只提醒一条新订单，请重复订阅并定期查看订单。拨打电话后，需要手动记录通知结果。</view><view class="name">金额与收款</view><view class="muted">订单金额用于记录参考价和门店确认价，收款在线下进行。</view></view></block>
<block wx:if="{{page==='mine' && !adminMode}}">
 <view class="customer-profile"><view class="customer-avatar"><image src="/assets/nav-profile-active.png"/></view><view class="grow"><view class="profile-name">我的</view><view class="profile-role">{{admin?'已绑定店主身份':'顾客服务'}}</view></view></view>
 <view class="profile-group"><button class="owner-menu-item" data-page="orders" bindtap="go" disabled="{{busy}}"><image class="menu-icon" src="/assets/nav-orders-active.png"/><text class="grow">我的订单</text><text class="menu-arrow">›</text></button><button class="owner-menu-item" data-phone="{{store.phone}}" bindtap="callPhone" disabled="{{!store.phone}}"><image class="menu-icon" src="/assets/action-phone.png"/><text class="grow">联系门店</text><text class="menu-arrow">›</text></button></view>
 <view class="profile-group"><button class="owner-menu-item" data-page="privacy" bindtap="go"><image class="menu-icon" src="/assets/action-help.png"/><text class="grow">个人信息使用说明</text><text class="menu-arrow">›</text></button></view>
 <view class="profile-group"><button class="owner-menu-item" data-page="claim" bindtap="go"><text class="grow">认领到店订单</text><text class="menu-arrow">›</text></button><button class="owner-menu-item" bindtap="clearContact"><text class="grow">清除本机保存的联系人</text><text class="menu-arrow">›</text></button></view>
 <view wx:if="{{admin}}" class="profile-group"><button class="owner-menu-item" bindtap="mode" disabled="{{busy}}"><image class="menu-icon" src="/assets/action-switch.png"/><text class="grow">切换店主端</text><text class="menu-arrow">›</text></button></view>
</block>
<block wx:if="{{page==='home' || page==='guest'}}">
 <block wx:if="{{page==='home'}}"><view class="hero"><view class="hero-layout"><view class="store-mark-frame"><image class="store-mark" src="{{store.storefrontUrl || '/assets/store-badge.png'}}" mode="aspectFill" aria-label="店铺标识"/></view><view class="hero-content"><view class="hero-title">{{store.name}}</view><button wx:if="{{store.latitude!==null && store.latitude!==undefined}}" class="hero-contact" bindtap="openLocation">导航到店</button><view class="hero-detail"><view class="hero-line"><text class="hero-label">地址</text><text class="hero-value">{{store.address}}</text></view><view class="hero-line"><text class="hero-label">营业时间</text><text class="hero-value">{{store.hours}}</text></view><view class="hero-line"><text class="hero-label">电话</text><text class="hero-value">{{store.phone}}</text></view></view><button class="hero-contact" data-phone="{{store.phone}}" bindtap="callPhone">联系门店</button></view></view></view><view wx:if="{{!store.open}}" class="notice">门店暂不接单，您仍可查看已有订单或联系门店。</view></block>
 <block wx:else><button class="back" data-page="workbench" bindtap="go">← 返回工作台</button><view class="heading">到店开单</view><view class="muted">衣物已在门店，请与顾客确认价格后开单。开单后可为顾客生成认领入口，认领后可查订单进度。</view><label class="field">联系人<input data-key="name" value="{{form.name}}" bindinput="field" maxlength="30" placeholder="顾客姓名"/></label><label class="field">联系电话<input data-key="phone" value="{{form.phone}}" bindinput="field" type="number" maxlength="11" placeholder="顾客手机号码"/></label><label class="field">备注（选填）<input data-key="note" value="{{form.note}}" bindinput="field" maxlength="200" placeholder="衣物需要注意的地方"/></label></block>
 <view class="row"><view><view class="heading">选择送洗服务</view><view class="muted">参考价格，以到店验收为准</view></view><text wx:if="{{!store.open && page==='home'}}" class="pill">暂停接单</text></view>
 <view class="catalog-layout">
  <scroll-view scroll-y class="category-list" aria-label="服务类目"><view wx:for="{{categories}}" wx:key="*this" class="category-item {{category===item?'active':''}}" data-value="{{item}}" bindtap="category">{{item}}</view></scroll-view>
  <view class="service-list"><block wx:for="{{products}}" wx:key="_id"><view wx:if="{{item.enabled && (category==='全部'||category===item.category)}}" class="service-card">
   <view class="service-info" data-id="{{item._id}}" bindtap="showService"><view class="service-name">{{item.name}}</view><view class="muted">{{item.category}} · 按{{item.unit}}计价</view><view class="price">¥{{item.priceText}} <text class="muted">/ {{item.unit}}</text></view></view>
   <image wx:if="{{item.imageUrl}}" class="service-image" src="{{item.imageUrl}}" mode="aspectFill" data-url="{{item.imageUrl}}" bindtap="previewImage" data-id="{{item._id}}" binderror="imageError" aria-label="查看商品图片大图"/><view wx:else class="service-placeholder">暂无服务图片</view>
   <view class="service-footer"><text class="service-detail-link" data-id="{{item._id}}" bindtap="showService">查看详情 ›</text><view class="step"><button class="step-button" data-id="{{item._id}}" data-delta="-1" bindtap="step" aria-label="减少数量">−</button><text class="step-count">{{item.qty}}</text><button class="step-button" data-id="{{item._id}}" data-delta="1" bindtap="step" aria-label="增加数量">+</button></view></view>
  </view></block><view wx:if="{{!products.length}}" class="empty">门店尚未添加价目，请稍后再来。</view></view>
 </view>
</block>
<block wx:if="{{page==='serviceDetail' && serviceDetail}}"><button class="back" bindtap="backToCatalog">← 返回服务列表</button><view class="card service-detail"><view class="heading">{{serviceDetail.name}}</view><view class="muted">{{serviceDetail.category}} · 按{{serviceDetail.unit}}计价</view><view class="price service-detail-price">¥{{serviceDetail.priceText}} <text class="muted">/ {{serviceDetail.unit}}</text></view><image wx:if="{{serviceDetail.imageUrl}}" class="service-detail-image" src="{{serviceDetail.imageUrl}}" mode="aspectFit" data-url="{{serviceDetail.imageUrl}}" bindtap="previewImage"/><view wx:if="{{serviceDetail.imageUrl}}" class="muted">点击图片查看大图</view><view wx:if="{{serviceDetail.description}}" class="muted">{{serviceDetail.description}}</view><view class="service-footer"><text class="muted">参考价格，到店验收后确认</text><view class="step"><button class="step-button" data-id="{{serviceDetail._id}}" data-delta="-1" bindtap="step" aria-label="减少数量">−</button><text class="step-count">{{serviceDetail.qty}}</text><button class="step-button" data-id="{{serviceDetail._id}}" data-delta="1" bindtap="step" aria-label="增加数量">+</button></view></view></view></block>
<block wx:if="{{page==='checkout'}}"><button class="back" data-page="home" bindtap="go">← 返回选择</button><view class="heading">填写送洗订单</view><view class="muted">留下联系方式，方便门店与您联系。</view><view class="card"><view wx:for="{{selected}}" wx:key="_id" class="row item"><text>{{item.name}} × {{item.qty}}</text><text>¥{{item.priceText}} / {{item.unit}}</text></view><view class="line"/><view class="row"><text>参考总价</text><text class="price">¥{{total}}</text></view></view><view class="notice">线上选择送洗服务，请在营业时间内将衣物送至门店。最终价格以门店验衣并与您确认为准。本小程序不提供在线支付。</view><label class="field">联系人<input data-key="name" value="{{form.name}}" bindinput="field" maxlength="30" placeholder="怎么称呼您"/></label><label class="field">联系电话<input data-key="phone" value="{{form.phone}}" bindinput="field" type="number" maxlength="11" placeholder="填写手机号码"/></label><label class="field">备注（选填）<textarea data-key="note" value="{{form.note}}" bindinput="field" maxlength="200" placeholder="例如：袖口需要重点清洗"/></label><view class="muted">姓名、电话和备注用于处理送洗订单及联系您。</view><checkbox-group bindchange="rememberContact"><label class="agreement"><checkbox value="yes" checked="{{rememberContact}}"/>在本机记住联系人（可在“我的”清除）</label></checkbox-group><button class="back" data-page="privacy" bindtap="go">查看个人信息使用说明</button><view class="actions"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">提交送洗订单</button></view></block>
<block wx:if="{{page==='privacy'}}"><button class="back" data-page="{{privacyReturn || 'mine'}}" bindtap="go">← 返回</button><view class="heading">个人信息使用说明</view><view class="card privacy-copy"><view class="name">服务与联系</view><view class="muted">服务门店：{{store.name}}。{{store.operatorName?'经营者：'+store.operatorName+'。':''}}如需查阅、更正或删除个人信息，请联系 {{store.privacyPhone || store.phone}}。</view><view class="name">收集哪些信息</view><view class="muted">门店处理您填写的联系人、联系电话、衣物项目、金额和备注，并通过微信身份标识区分订单。认领到店订单后，该订单会与您的微信关联。请勿填写与洗护无关的敏感信息。</view><view class="name">用途与访问</view><view class="muted">信息用于收衣核价、联系取件、交付核对及处理洗护争议。顾客仅能查看自己的订单。店主内部备注、异常照片和认领密钥不会向其他顾客开放。</view><view class="name">保存与处理</view><view class="muted">订单暂按 {{store.retentionDays || 365}} 天安排保存，到期由门店核查服务是否结束、是否仍有争议及其他保存需要后处理。进行中的服务不会因到期自动删除。您的个人信息申请将由门店核实身份并回复处理。</view><view class="name">本机联系人与图片</view><view class="muted">只有勾选“在本机记住联系人”才会在本机保存姓名和电话，可在“我的”清除。店主选择衣物图片用于验衣与异常处理，选择商品或门头图片用于门店服务展示；拒绝图片授权后仍可使用文字操作。</view><button class="secondary form-save" data-phone="{{store.privacyPhone || store.phone}}" bindtap="callPhone">联系门店处理个人信息申请</button></view></block>
<block wx:if="{{page==='orders' || page==='admin'}}">
 <view wx:if="{{page==='orders'}}"><view class="heading">我的订单</view><view class="muted">查看您的送洗进度</view></view>
 <label wx:if="{{page==='admin'}}" class="field"><input value="{{searchText}}" bindinput="search" placeholder="输入完整手机号或页面单号"/></label><view wx:if="{{page==='admin'}}" class="actions"><button class="secondary" bindtap="searchOrders">搜索</button><button class="secondary" bindtap="loadOrders">刷新订单</button></view><view wx:if="{{page==='admin'}}" class="muted">更新于 {{refreshedAt || '尚未刷新'}}</view>
 <scroll-view scroll-x class="tabs"><text wx:for="{{page==='admin'?['全部','待送店','洗护中','待通知','待取件','超期','异常','已完成','已取消']:['全部','进行中','已结束']}}" wx:key="*this" class="tab {{filter===item?'active':''}}" data-value="{{item}}" bindtap="filter">{{item}}</text></scroll-view>
 <view wx:for="{{shownOrders}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open"><view class="row"><text class="name">订单 {{item.shortId}}</text><text class="pill">{{item.statusLabel}}</text></view><view wx:if="{{page==='admin'}}" class="muted">{{item.createdText}} · {{item.phone}} · {{item.itemCount}} 件</view><view wx:if="{{page==='admin' && item.status==='pending' && item.source==='customer' && item.notifyState}}" class="muted">{{item.notifyState==='sent'?'已请求发送提醒，请以微信消息为准':item.notifyState==='failed'?'提醒未发送，请检查订阅并及时处理':'提醒状态待确认，请及时处理'}}</view><view class="muted item"><text wx:for="{{item.displayItems}}" wx:for-item="goods" wx:key="id">{{goods.name}} × {{goods.qty}}　</text></view><view class="line"/><view class="row"><text class="muted">{{item.source==='guest'?'代客单 · ':''}}{{item.name}}</text><text class="price">¥{{item.amount}}</text></view></view>
 <view wx:if="{{listLoading}}" class="empty">正在加载订单…</view><view wx:elif="{{listError}}" class="notice">订单加载失败，请检查网络。<button class="secondary" bindtap="loadOrders">重新加载订单</button></view><view wx:elif="{{!shownOrders.length}}" class="empty">{{filter==='全部' && !searchText?'还没有订单':'没有符合当前条件的订单'}}<button wx:if="{{filter!=='全部' || searchText}}" class="secondary" bindtap="clearOrderFilter">查看全部订单</button></view><button wx:if="{{hasMore}}" class="secondary" bindtap="more">继续加载订单</button><view wx:if="{{!hasMore && shownOrders.length}}" class="muted">没有更多订单</view>
</block>
<block wx:if="{{page==='detail' && order}}"><button class="back" data-page="{{adminMode?(orderReturn || 'admin'):'orders'}}" bindtap="go">← {{adminMode && orderReturn==='workbench'?'返回工作台':'返回订单'}}</button><view class="{{adminMode?'owner-order-status':'status'}}"><view class="heading">{{adminMode && order.status==='pending'?'收衣核价':order.statusLabel}}</view><view wx:if="{{!adminMode}}" class="muted">{{order.desc}}</view><view wx:if="{{justSubmitted && !adminMode}}" class="muted">此处未支付。{{store.address}} · 营业时间 {{store.hours}}</view></view>
 <view wx:if="{{detailStale}}" class="notice">您有未保存的收衣调整，请先保存；也可放弃调整后刷新。<button class="secondary" bindtap="discardAndRefresh">放弃调整并刷新</button></view>
 <template wx:if="{{adminMode && (order.status==='pending' || editingReceipt)}}" is="receiptEditor" data="{{editItems,editChanged,reason,agreed,intakeTotal,intakeForm,enabledProducts,busy,editingReceipt,showIntake,guestReview:false}}"/><button wx:if="{{editingReceipt}}" class="back" bindtap="discardAndRefresh">放弃本次调整</button>
 <button wx:if="{{adminMode && order.status==='pending'}}" class="back danger" bindtap="cancel">取消未收衣订单</button>
 <view wx:if="{{adminMode && order.status==='processing' && !editingReceipt}}" class="actions"><button class="primary" data-op="ready" bindtap="transition">标记洗好</button></view>
 <view wx:if="{{adminMode && order.status==='ready' && !editingReceipt}}" class="card"><view class="row"><text class="name">电话通知</text><text class="pill">{{order.notice}}</text></view><view class="muted">请拨打 {{order.phone}}，通话后手动记录结果。</view><view class="actions"><button class="secondary" data-phone="{{order.phone}}" bindtap="callPhone">拨打电话</button><button class="secondary" data-op="notice" data-notice="已通知" bindtap="transition">已通知</button><button class="secondary" data-op="notice" data-notice="未接通" bindtap="transition">未接通</button><button class="primary" data-op="complete" bindtap="transition">登记已取件</button><button class="secondary" data-op="correct" bindtap="transition">纠正为洗护中</button></view></view>
 <view wx:if="{{adminMode && order.status==='completed'}}" class="actions"><button class="secondary" data-op="correct" bindtap="transition">纠正为待取件</button></view>
 <view class="card"><view class="order-info-heading"><text class="name">订单信息</text><text class="order-short-number muted">{{order.shortId}}</text><button wx:if="{{adminMode}}" class="text-action" bindtap="copyOrderId">复制单号</button></view><view class="line"/><view class="row item"><text>联系人</text><text>{{order.name}} {{order.phone}}</text></view><view wx:for="{{order.displayItems}}" wx:key="id" class="row item"><text>{{item.name}} × {{item.qty}}{{item.unit}}</text><text>¥{{item.amount}}</text></view><view class="line"/><view wx:if="{{order.actual!==null}}" class="row"><text>下单参考金额</text><text>¥{{order.estimateText}}</text></view><view class="row"><text>{{order.actual===null?'参考总价':'门店确认金额'}}</text><text class="price">¥{{order.amount}}</text></view><view wx:if="{{order.note}}" class="muted">备注：{{order.note}}</view><view wx:if="{{adminMode && order.source==='guest'}}" class="muted">{{order.owner?'顾客已认领，可查看订单进度':'顾客尚未认领，可电话联系或分享认领入口'}}</view></view>
 <view wx:if="{{order.ticketNo || order.dueDate}}" class="card"><view wx:if="{{order.ticketNo}}">挂号／纸票号：{{order.ticketNo}}</view><view wx:if="{{order.dueDate}}" class="muted">预计完成：{{order.dueDate}}，请以洗好后的取件状态为准。</view></view>
 <view wx:if="{{order.publicUpdates.length}}" class="card"><view class="name">门店说明</view><view wx:for="{{order.publicUpdates}}" wx:key="time" class="log">{{item.text}}</view></view>
 <view wx:if="{{adminMode && order.status!=='pending' && !editingReceipt}}" class="card"><button class="back" bindtap="toggleIntake">挂号、位置与内部备注 {{showIntake?'收起':'展开'}}</button><view wx:if="{{order.storageLocation}}" class="muted">位置：{{order.storageLocation}}</view><view wx:if="{{showIntake}}"><label class="field">挂号／纸票号<input data-key="ticketNo" value="{{intakeForm.ticketNo}}" bindinput="intakeField" maxlength="30"/></label><label class="field">存放位置<input data-key="storageLocation" value="{{intakeForm.storageLocation}}" bindinput="intakeField" maxlength="60"/></label><view class="field">预计完成日期<picker mode="date" value="{{intakeForm.dueDate}}" bindchange="dueDate"><view>{{intakeForm.dueDate || '选择日期'}}</view></picker><button class="text-action" bindtap="clearDueDate">清除日期</button></view><label class="field">内部备注<textarea data-key="internalNote" value="{{intakeForm.internalNote}}" bindinput="intakeField" maxlength="500"/></label><button class="primary" bindtap="saveIntake" disabled="{{busy}}">保存收衣资料</button></view></view>
 <view wx:if="{{adminMode && !editingReceipt}}" class="card"><view class="name">更多处理</view><view class="actions"><button class="secondary" bindtap="openCase" disabled="{{busy}}">记录异常／返洗</button><button wx:if="{{order.status==='processing' || order.status==='ready'}}" class="secondary" bindtap="beginRevision">调整衣物与金额</button><button wx:if="{{order.source==='guest' && !order.owner && order.status!=='cancelled'}}" class="secondary" bindtap="issueClaim" disabled="{{busy}}">生成顾客认领入口</button></view><view wx:if="{{claimLink}}" class="notice">请先核对顾客，再分享或复制认领码。入口 30 分钟内有效且只能认领一次。<view class="actions"><button class="secondary" bindtap="copyClaim">复制认领码</button><button class="primary" open-type="share">分享认领入口</button></view></view><button wx:if="{{order.status==='processing' || order.status==='ready'}}" class="back danger" bindtap="cancelAfterReceipt">退单并登记衣物已退还</button></view>
 <view wx:if="{{adminMode && order.cases.length}}" class="card"><view class="name">异常处理（店主可见）</view><view wx:for="{{order.cases}}" wx:key="id" class="case-record"><view class="name">{{item.type}} · {{item.resolved?'已处理':'待处理'}}</view><view class="muted">{{item.text}}</view><image wx:for="{{item.photoUrls}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" class="evidence-photo" mode="aspectFill" data-url="{{photo}}" bindtap="previewImage"/><view wx:if="{{item.resolution}}" class="muted">处理结果：{{item.resolution}}</view><button wx:if="{{!item.resolved}}" class="secondary" data-id="{{item.id}}" bindtap="resolveCase">记录处理结果</button></view></view>
 <view class="card"><view class="name">订单记录</view><view wx:for="{{order.events}}" wx:key="index" class="log">{{item.time}}　{{item.text}}</view></view><view wx:if="{{!adminMode}}" class="actions"><button wx:if="{{order.status==='pending'}}" class="danger" bindtap="cancel">取消订单</button><button class="secondary" data-phone="{{store.phone}}" bindtap="callPhone">联系门店</button></view>
</block>
<block wx:if="{{page==='settings'}}"><button class="back" data-page="manage" bindtap="go">← 返回我的门店</button><view class="heading">门店设置</view><label wx:for="{{[{key:'name',label:'门店名称'},{key:'address',label:'地址'},{key:'phone',label:'联系电话'},{key:'hours',label:'营业时间'}]}}" wx:key="key" class="field">{{item.label}}<input data-key="{{item.key}}" value="{{store[item.key]}}" bindinput="storeField"/></label><label class="field">经营者姓名／营业执照全称<input data-key="operatorName" value="{{store.operatorName}}" bindinput="storeField" maxlength="100"/></label><label class="field">个人信息申请联系电话<input data-key="privacyPhone" value="{{store.privacyPhone || store.phone}}" bindinput="storeField"/></label><label class="field">已结束订单保存天数<input data-key="retentionDays" type="number" value="{{store.retentionDays || 365}}" bindinput="storeField"/></label><button class="secondary" bindtap="chooseStoreLocation">选择／修改地图位置</button><view class="muted">{{store.latitude!==null && store.latitude!==undefined?'已设置地图位置':'尚未设置地图位置，顾客仍可查看文字地址'}}</view><button class="secondary form-save" bindtap="chooseStorefront">选择／修改门头照片</button><view class="row card"><text>接受新订单</text><switch checked="{{store.open}}" bindchange="toggleStore" color="#1b57c5"/></view><view class="muted">修改经营者或隐私联系资料后，请同步微信后台隐私指引。</view><button class="primary" bindtap="saveStore" disabled="{{busy}}">保存门店信息</button><view class="muted" style="margin-top:24rpx">首次绑定店主需要您的微信身份标识。</view><button class="secondary" bindtap="copyId">复制微信身份标识</button></block>
<block wx:if="{{page==='prices'}}"><button class="back" data-page="workbench" bindtap="go">← 返回工作台</button><view class="heading price-title">价目管理</view>
 <view class="price-toolbar"><button class="secondary" bindtap="newCategory" disabled="{{busy}}">添加类目</button><button class="primary" bindtap="newProduct" disabled="{{busy}}">添加单品</button></view>
 <view class="price-manager"><scroll-view scroll-y class="price-category-list"><button class="price-category {{priceCategory==='全部'?'active':''}}" data-value="全部" bindtap="priceCategory">全部<text class="category-count">{{products.length}}</text></button><button wx:for="{{priceCategories}}" wx:key="name" class="price-category {{priceCategory===item.name?'active':''}}" data-value="{{item.name}}" bindtap="priceCategory">{{item.name}}<text class="category-count">{{item.count}}</text></button></scroll-view>
 <view class="price-product-list"><button wx:for="{{priceProducts}}" wx:key="_id" class="price-product" data-id="{{item._id}}" bindtap="editProduct" disabled="{{busy}}"><image wx:if="{{item.imageUrl}}" class="pic" src="{{item.imageUrl}}" mode="aspectFill"/><view class="grow"><view class="name">{{item.name}}</view><view class="price">¥{{item.priceText}} / {{item.unit}}</view><view class="muted">{{item.enabled?'已上架':'已停用'}}</view></view><text class="menu-arrow">›</text></button><view wx:if="{{!priceProducts.length}}" class="price-empty"><view class="muted">{{priceCategory==='全部'?'还没有单品':'此类目下还没有单品'}}</view><button class="secondary" bindtap="newProduct" disabled="{{busy}}">添加单品</button></view></view></view>
 <view class="muted price-hint">修改价目仅影响新订单。</view>
</block>
<block wx:if="{{page==='categoryForm'}}"><button class="back" data-page="{{categoryReturn}}" bindtap="go">← {{categoryReturn==='product'?'返回单品':'返回价目'}}</button><view class="heading">添加类目</view><label class="field">类目名称<input value="{{categoryDraft}}" bindinput="categoryField" maxlength="30" placeholder="例如：衣物、鞋靴、家纺"/></label><button class="primary form-save" bindtap="saveCategory" loading="{{busy}}" disabled="{{busy}}">保存类目</button></block>
<block wx:if="{{page==='product'}}"><button class="back" data-page="prices" bindtap="go">← 返回价目</button><view class="heading">{{product.id?'编辑单品':'添加单品'}}</view><label class="field">单品名称<input data-key="name" value="{{product.name}}" bindinput="productField" placeholder="例如：羽绒服清洗"/></label><view class="field"><view class="row"><text>所属类目</text><button class="text-action" bindtap="newCategory" disabled="{{busy}}">添加类目</button></view><picker wx:if="{{productCategoryNames.length}}" mode="selector" range="{{productCategoryNames}}" value="{{productCategoryIndex}}" bindchange="pickProductCategory"><view class="row"><text>{{product.category || '选择类目'}}</text><text class="menu-arrow">›</text></view></picker><view wx:else class="muted">请先添加一个类目，再保存单品。</view></view><label class="field">单位<input data-key="unit" value="{{product.unit}}" bindinput="productField" placeholder="件、双等"/></label><label class="field">参考单价（元）<input data-key="price" type="digit" value="{{product.price}}" bindinput="productField" placeholder="0.00"/></label><label class="field">服务说明（选填）<textarea data-key="description" value="{{product.description}}" bindinput="productField" maxlength="300" placeholder="填写特殊处理说明"/></label><view class="row card"><text>上架单品</text><switch checked="{{product.enabled}}" bindchange="toggleProduct" color="#1b57c5"/></view><image wx:if="{{product.localImage || product.imageUrl}}" class="pic" src="{{product.localImage || product.imageUrl}}" mode="aspectFill"/><view class="actions"><button class="secondary" bindtap="chooseImage">选择商品图片</button><button class="primary" disabled="{{busy}}" bindtap="saveProduct">保存单品</button></view></block>
<block wx:if="{{page==='guestReview'}}"><button class="back" data-page="guest" bindtap="go">← 返回衣物选择</button><view class="heading">核对收衣与金额</view><view class="muted">{{form.name}} {{form.phone}}</view><template is="receiptEditor" data="{{editItems,editChanged,reason,agreed,intakeTotal,intakeForm,enabledProducts,busy,showIntake,editingReceipt:false,guestReview:true}}"/></block>
<block wx:if="{{page==='claim'}}"><button class="back" data-page="mine" bindtap="go">← 返回我的</button><view class="heading">认领到店订单</view><label class="field">店主提供的认领码<textarea value="{{claimInput}}" bindinput="claimField" maxlength="250" placeholder="粘贴完整认领码"/></label><button class="secondary" bindtap="previewClaim" disabled="{{busy}}">核对订单</button><view wx:if="{{claimError}}" class="notice">{{claimError}}</view><view wx:if="{{claimPreview}}" class="card"><view>联系人 {{claimPreview.name}} · 手机尾号 {{claimPreview.phoneTail}}</view><view>共 {{claimPreview.itemCount}} 件衣物</view><view class="muted">仅认领您本人送洗的订单，认领后可用当前微信查进度。</view><button class="primary form-save" bindtap="claimOrder" disabled="{{busy}}">确认认领此订单</button></view></block>
<block wx:if="{{page==='case' && adminMode}}"><button class="back" data-page="detail" bindtap="go">← 返回订单</button><view class="heading">异常／返洗记录</view><view class="field">异常类型<picker range="{{caseTypes}}" bindchange="caseType"><view>{{caseForm.type}}</view></picker></view><label class="field">内部处理说明<textarea data-key="text" value="{{caseForm.text}}" bindinput="caseField" maxlength="500" placeholder="记录衣物情况、沟通与处理安排"/></label><label class="field">给顾客看的说明（选填）<textarea data-key="publicText" value="{{caseForm.publicText}}" bindinput="caseField" maxlength="300"/></label><view class="muted">内部说明和衣物照片仅店主可见。</view><image wx:for="{{caseForm.photos}}" wx:key="*this" src="{{item}}" class="evidence-photo" mode="aspectFill"/><view class="actions"><button class="secondary" bindtap="chooseCasePhotos">选择衣物照片（最多3张）</button><button class="primary" bindtap="saveCase" disabled="{{busy}}">保存异常记录</button></view></block>
<block wx:if="{{page==='retention' && adminMode}}"><button class="back" data-page="manage" bindtap="go">← 返回我的门店</button><view class="heading">到期订单核查</view><view class="muted">仅列出已结束且超过保存期限的订单。请核查是否仍有争议或保存需要，再由门店处理个人信息；不会自动删除订单。每次最多显示100条。</view><view wx:for="{{retentionRows}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open">{{item.businessNumber || item._id}}<view class="muted">{{item.updatedAt}}</view></view><view wx:if="{{!retentionRows.length}}" class="empty">暂无需要核查的到期订单</view></block>
</view>
<view wx:if="{{page==='home' || page==='guest'}}" class="bottom {{page==='guest'?'bottom-guest':''}}"><view><view class="price">¥{{total}} <text class="muted">参考价</text></view><view class="muted">已选 {{count}} 件</view></view><button wx:if="{{page==='guest'}}" class="primary" disabled="{{!count || busy}}" bindtap="submit">确认收衣并开单</button><button wx:else class="primary" disabled="{{!count || !store.open || busy}}" data-page="checkout" bindtap="go">填写订单 →</button></view>
<view wx:if="{{!adminMode && (page==='home' || page==='orders' || page==='mine')}}" class="nav"><button class="nav-item {{page==='home'?'active':''}}" data-page="home" bindtap="go" aria-label="送洗"><image class="nav-icon" src="{{page==='home'?'/assets/nav-wash-active.png':'/assets/nav-wash.png'}}"/><text>送洗</text></button><button class="nav-item {{page==='orders'?'active':''}}" data-page="orders" bindtap="go" aria-label="我的订单"><image class="nav-icon" src="{{page==='orders'?'/assets/nav-orders-active.png':'/assets/nav-orders.png'}}"/><text>我的订单</text></button><button class="nav-item {{page==='mine'?'active':''}}" data-page="mine" bindtap="go" aria-label="我的"><image class="nav-icon" src="{{page==='mine'?'/assets/nav-profile-active.png':'/assets/nav-profile.png'}}"/><text>我的</text></button></view>
<view wx:if="{{adminMode && (page==='workbench' || page==='admin' || page==='manage')}}" class="nav owner-nav" aria-label="店主端导航"><button class="nav-item {{page==='workbench'?'active':''}}" data-page="workbench" bindtap="adminTab" disabled="{{busy}}" aria-label="工作台"><image class="nav-icon" src="{{page==='workbench'?'/assets/nav-workbench-active.png':'/assets/nav-workbench.png'}}"/><text>工作台</text></button><button class="nav-item {{page==='admin'?'active':''}}" data-page="admin" bindtap="adminTab" disabled="{{busy}}" aria-label="订单"><image class="nav-icon" src="{{page==='admin'?'/assets/nav-orders-active.png':'/assets/nav-orders.png'}}"/><text>订单</text></button><button class="nav-item {{page==='manage'?'active':''}}" data-page="manage" bindtap="adminTab" disabled="{{busy}}" aria-label="我的门店"><image class="nav-icon" src="{{page==='manage'?'/assets/nav-profile-active.png':'/assets/nav-profile.png'}}"/><text>我的门店</text></button></view>
</block>
